{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/**"],
            "message": "Importa otra feature solo por su index.ts (por ejemplo, '@/features/progreso'). Dentro de tu propia feature usa rutas relativas."
          },
          {
            "group": ["@/app/**", "@/app"],
            "message": "Las features no importan de app/: reciben la navegación como props."
          }
        ]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features", "@/features/**", "@/app", "@/app/**"],
                "message": "shared/ no importa features ni app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "app/ usa cada feature solo por su index.ts."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"]
}
